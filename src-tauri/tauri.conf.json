{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "All IN ONE",
  "version": "1.2.0",
  "identifier": "com.allinone.hghub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/sync-android-icons.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "All IN ONE",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ]
  }
}
